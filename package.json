{
  "name": "@sandsoftwaresolutions/csv-safe",
  "version": "0.2.0",
  "description": "Read and write CSV safely: quotes, Dutch Excel, and protection against formula injection in exports.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "csv",
    "excel",
    "security",
    "parser"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-csv-safe.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-csv-safe/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-csv-safe#readme",
  "publishConfig": {
    "access": "public"
  }
}
